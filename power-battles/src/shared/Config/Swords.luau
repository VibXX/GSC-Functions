Swords.ById = {}
for _, def in Swords.List do
	assert(Swords.Archetypes[def.Archetype], "Unknown archetype on sword " .. def.Id)
	assert(Rarities.Info[def.Rarity], "Unknown rarity on sword " .. def.Id)
	Swords.ById[def.Id] = def
end

-- Final combat stats for a sword at a card level.
-- normalized = true ignores rarity + level (used by custom games with "Card Levels" off).
function Swords.GetStats(id: string, level: number?, normalized: boolean?)
	local def = Swords.ById[id] or Swords.ById.InitiatesBlade
	local arch = Swords.Archetypes[def.Archetype]
	local scale = 1
	if not normalized then
		scale = Rarities.Info[def.Rarity].StatScale * Progression.DamageMultiplier(level)
	end
	local swingCooldown = arch.SwingCooldown
	if def.Passive and def.Passive.Type == "Haste" then
		swingCooldown *= def.Passive.Mult
	end
	return {
		Damage = arch.Damage * scale,
		SwingCooldown = swingCooldown,
		Range = arch.Range,
		ComboLength = arch.ComboLength,
		FinisherMultiplier = arch.FinisherMultiplier,
		MoveSpeedMultiplier = arch.MoveSpeedMultiplier,
		HitDelay = arch.HitDelay,
		Passive = def.Passive,
	}
end

return Swords
